{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Binding",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "github_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "required": [
    "repository",
    "github_run_id",
    "attempt",
    "revision"
  ],
  "additionalProperties": false
}
